# Production .env — copy to the deploy folder on the VPS as `.env` (never commit it).
# Used by docker compose (port) and passed to the app container.

PORT=9632
# 127.0.0.1 behind a reverse proxy (Nginx) that serves HTTPS; 0.0.0.0 to expose the port directly
APP_BIND=127.0.0.1
# PIN the presenter types at /host — change it
HOST_PIN=change_me
RUST_LOG=presentation_api=info,tower_http=warn,socketioxide=warn
